{
    "name": "vconnect/integrity-checker",
    "type": "project",
    "version": "2.10.1",
    "bin": [
        "bin/dependencies",
        "bin/structure",
        "bin/disassembling"
    ],
    "require": {
        "php": "~8.1.0|~8.2.0|~8.3.0",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "ext-zlib": "*",
        "league/climate": "^3",
        "composer/composer": "^2",
        "webonyx/graphql-php": "^15.0",
        "php-di/php-di": "^7.0",
        "adbario/php-dot-notation": "^3.3"
    },
    "suggest": {
        "vconnect/integrity-checker-composer-plugin": "Enables vendor packages cache to improve analysis performaance"
    },
    "autoload": {
        "psr-4": {
            "Vconnect\\IntegrityChecker\\": "src"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4"
    }
}
