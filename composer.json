{
    "name": "vconnect/integrity-checker",
    "description": "Static analysis tool for Magento 2 module packages: checks composer.json/module.xml dependency integrity and generates module disassembling roadmaps.",
    "type": "library",
    "version": "2.13.1",
    "license": "AGPL-3.0-only",
    "bin": [
        "bin/dependencies",
        "bin/disassembling"
    ],
    "require": {
        "php": "~8.2.0|~8.3.0|~8.4.0|~8.5.0",
        "ext-json": "*",
        "ext-simplexml": "*",
        "ext-dom": "*",
        "ext-zlib": "*",
        "league/climate": "^3",
        "composer/composer": "^2",
        "webonyx/graphql-php": "^15.0",
        "php-di/php-di": "^7.0",
        "adbario/php-dot-notation": "^3.3"
    },
    "suggest": {
        "vconnect/integrity-checker-composer-plugin": "Enables vendor packages cache to improve analysis performaance"
    },
    "autoload": {
        "psr-4": {
            "Vconnect\\IntegrityChecker\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vconnect\\IntegrityChecker\\Tests\\": "tests/testsuite"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^6.4",
        "phpunit/phpunit": "^13.2",
        "rector/rector": "^2.5",
        "laravel/pint": "^1.29",
        "squizlabs/php_codesniffer": "^3.10|^4.0",
        "phpcompatibility/php-compatibility": "dev-develop as 9.9.9",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpro/grumphp-shim": "^2.23",
        "yieldstudio/grumphp-laravel-pint": "^1.0",
        "phpstan/phpstan": "^2.2",
        "symfony/options-resolver": "^8.1"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpro/grumphp-shim": true
        }
    },
    "scripts": {
        "test": "phpunit -c tests/phpunit.xml",
        "cs": "phpcs --standard=phpcs.xml",
        "rector": "rector --dry-run",
        "lint": "pint --test"
    }
}
