#!/usr/bin/env php
<?php declare(strict_types=1);

use Vconnect\IntegrityChecker\Analysis\Data\DefectiveResultInterface;
use Vconnect\IntegrityChecker\Analysis\Enum\DefaultAnalysisFolders;
use Vconnect\IntegrityChecker\Analysis\Service\Dependencies;
use Vconnect\IntegrityChecker\Application\Dependencies\Console;
use Vconnect\IntegrityChecker\Application\Filesystem\DirectoryRegistry;
use Vconnect\IntegrityChecker\Domain\PackagesRegistry;

try {
    require_once __DIR__ . '/../bootstrap.php';
} catch (Throwable $exception) {
    echo $exception;
    die(2);
}

$console = App()->get(Console::class);

if (!$console->validateParameters()) {
    $console->printHelp();
    die(2);
}

$root = DirectoryRegistry::getRoot();
$directories = array_slice($argv, 2);

if (empty($directories)) {
    $directories = [$root . DefaultAnalysisFolders::APP, $root . DefaultAnalysisFolders::SRC];
}

$packages = App()->get(PackagesRegistry::class)->getPackages($directories);

$analyzer = App()->get(Dependencies::class);

/** @var DefectiveResultInterface $result */
foreach ($analyzer->analyse($packages) as $result) {
    $console->printOutput($result);
}

exit($console->getStatusCode());
