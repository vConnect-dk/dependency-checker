#!/usr/bin/env php
<?php declare(strict_types=1);

use Vconnect\IntegrityChecker\Analysis\Data\ResultInterface;
use Vconnect\IntegrityChecker\Analysis\Enum\DefaultAnalysisFolders;
use Vconnect\IntegrityChecker\Analysis\Enum\DefaultPackageStructure;
use Vconnect\IntegrityChecker\Analysis\Service\Structure;
use Vconnect\IntegrityChecker\Application\Structure\Console;
use Vconnect\IntegrityChecker\Domain\Scanner\FileSystemPackagesProvider;

function exception_error_handler($severity, $message, $file, $line) {
    if (!(error_reporting() & $severity)) {
        // This error code is not included in error_reporting
        return;
    }
    throw new ErrorException($message, 0, $severity, $file, $line);
}
set_error_handler("exception_error_handler");

try {
    require_once __DIR__ . '/../bootstrap.php';
} catch (\Throwable $exception) {
    echo 'Can not load autoload file. Please try to re-install project';
    die(2);
}

$console = new Console();

if (!$console->validateParameters()) {
    $console->printHelp();
    die(2);
}

$directories = array_slice($argv, 2);

if (empty($directories)) {
    $directories = [DefaultAnalysisFolders::APP, DefaultAnalysisFolders::SRC];
}

$analyzer = new Structure(DefaultPackageStructure::STRUCTURE);
$scanner = new FileSystemPackagesProvider();

$filter = function (SplFileInfo $fileInfo) {
    return (bool)preg_match('/ComponentRegistrar::MODULE/', php_strip_whitespace($fileInfo->getPathname()));
};

$packages = $scanner->getPackagesRecursively($directories, $filter, '/registration\\.php/');

/** @var ResultInterface $result */
foreach ($analyzer->analyse($packages) as $result) {
    $console->printOutput($result);
}

exit($console->getStatusCode());
