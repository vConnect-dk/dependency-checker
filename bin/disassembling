#!/usr/bin/env php
<?php declare(strict_types=1);

use Vconnect\IntegrityChecker\Analysis\Data\TopologicalOrder\Result;
use Vconnect\IntegrityChecker\Analysis\Enum\DefaultAnalysisFolders;
use Vconnect\IntegrityChecker\Application\Dependencies\Console;
use Vconnect\IntegrityChecker\Domain\PackagesRegistry;

function exception_error_handler($severity, $message, $file, $line) {
    if (!(error_reporting() & $severity)) {
        // This error code is not included in error_reporting
        return;
    }
    throw new ErrorException($message, 0, $severity, $file, $line);
}
set_error_handler("exception_error_handler");
ini_set("memory_limit", "-1");

$dir = __DIR__;
try {
    require_once $dir . '/../bootstrap.php';
} catch (\Throwable $exception) {
    echo 'Can not load autoload file. Please try to re-install project';
    die(2);
}

$console = new \Vconnect\IntegrityChecker\Application\Disassembling\Console();

if (!$console->validateParameters()) {
    $console->printHelp();
    die(2);
}

$directories = [ROOT_DIR . DefaultAnalysisFolders::APP, ROOT_DIR . DefaultAnalysisFolders::SRC, ROOT_DIR . 'vendor'];

$packages = PackagesRegistry::getInstance()->getPackages($directories, false);

$whitelist = [];
$whitelistArgument = $console->getWhitelist();

if (isset($whitelistArgument)) {
    $file = null;
    if (is_file($whitelistArgument)) {
        $file = $whitelistArgument;
    } elseif (is_file(ROOT_DIR . '/' . $whitelistArgument)) {
        $file = ROOT_DIR . '/' . $whitelistArgument;
    }

    if ($file) {
        $whitelist = explode(PHP_EOL, file_get_contents($file));
    } elseif (!empty($whitelistArgument)) {
        $whitelist = explode(',', $whitelistArgument);
    }
}

$analyzer = new Vconnect\IntegrityChecker\Analysis\Service\TopologicalOrder($whitelist);

$console->printOutput(new Result($analyzer->analyse($packages)));
