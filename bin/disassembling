#!/usr/bin/env php
<?php declare(strict_types=1);

use Vconnect\IntegrityChecker\Analysis\Data\TopologicalOrder\Result;
use Vconnect\IntegrityChecker\Analysis\Enum\DefaultAnalysisFolders;
use Vconnect\IntegrityChecker\Analysis\Service\TopologicalOrder;
use Vconnect\IntegrityChecker\Analysis\Service\TopologicalOrder\WhitelistProcessor;
use Vconnect\IntegrityChecker\Application\Disassembling\Console;
use Vconnect\IntegrityChecker\Domain\PackagesRegistry;

$dir = __DIR__;
try {
    require_once $dir . '/../bootstrap.php';
} catch (Throwable $exception) {
    echo 'Can not load autoload file. Please try to re-install project';
    die(2);
}

$console = App()->get(Console::class);

if (!$console->validateParameters()) {
    $console->printHelp();
    die(2);
}

$directories = [ROOT_DIR . DefaultAnalysisFolders::APP, ROOT_DIR . DefaultAnalysisFolders::SRC, ROOT_DIR . 'vendor'];

$packages = App()->get(PackagesRegistry::class)->getPackages($directories, false);
$packages = iterator_to_array($packages);

$whitelist = [];
$whitelistArgument = $console->getWhitelist();

if (!empty($whitelistArgument)) {
    $file = null;
    if (is_file($whitelistArgument)) {
        $file = $whitelistArgument;
    } elseif (is_file(ROOT_DIR . '/' . $whitelistArgument)) {
        $file = ROOT_DIR . '/' . $whitelistArgument;
    }

    if ($file) {
        $whitelist = array_flip(explode(PHP_EOL, file_get_contents($file)));
    } elseif (!empty($whitelistArgument)) {
        $whitelist = array_flip(explode(',', $whitelistArgument));
    }
}

$analyzer = App()->make(
    TopologicalOrder::class, [
        'whiteList' => App()->get(WhitelistProcessor::class)->process($whitelist, $packages),
        'explain' => $console->getExplainArgument(),
        'useCache' => !$console->getNoCacheArgument()]
);

$console->printOutput(new Result($analyzer->analyse($packages)));
