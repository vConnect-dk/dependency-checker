#!/usr/bin/env php
<?php declare(strict_types=1);

use Vconnect\IntegrityChecker\Application\Filesystem\DirectoryRegistry;
use Vconnect\IntegrityChecker\Domain\Package\Cache;

try {
    require_once __DIR__ . '/../../bootstrap.php';
} catch (Throwable $exception) {
    echo 'Can not load autoload file. Please try to re-install project';
    die(2);
}

$root = $argv[1] ?? getcwd();
DirectoryRegistry::setRoot(rtrim($root, '/') . '/');

App()->get(Cache::class)->clear();
